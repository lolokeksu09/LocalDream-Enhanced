<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Where models are kept is a fact about this device (ModelStorage). -->
    <exclude domain="sharedpref" path="model_storage.xml"/>
    <exclude domain="sharedpref" path="app_prefs.xml"/>
    <exclude domain="sharedpref" path="remote_session_secrets.xml"/>
</full-backup-content>